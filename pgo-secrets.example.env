# Copy of the settings "npm run setup" writes to pgo-secrets.env. The real file is never committed.
PORT=3443
SITE_NAME=PGO Mock Lab
DATA_KEY=            # 64 hex chars, made by setup. Losing it makes data/*.enc unreadable. Back it up.
SESSION_SECRET=      # made by setup
ADMIN_EMAIL=         # this email sees the Admin page

# 1 = local testing: login code shown on screen, payments simulated. Set 0 before going public.
DEV_MODE=1

# Email login codes (https://resend.com). Leave empty to print codes in the terminal.
RESEND_API_KEY=
MAIL_FROM=           # e.g. PGO Mock Lab <login@pgomocklab.in>

# Razorpay. Leave empty to simulate payments in DEV_MODE.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Prices in paise (49900 = Rs 499)
PRICE_SINGLE_PAISE=49900
PRICE_PACK_PAISE=349900
